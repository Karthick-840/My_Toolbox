# ─────────────────────────────────────────────────────────────
# llm_toolbox — environment configuration template
# Copy this file to .env and fill in your values:
#   cp llm_toolbox/.env.example llm_toolbox/.env
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Embedding provider ────────────────────────────────────────
# Options: ollama | gemini | huggingface | bedrock
EMBEDDING_PROVIDER=ollama

# Model used when EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=granite-embedding

# Model used when EMBEDDING_PROVIDER=huggingface (local, no key needed)
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LLM / chat model ─────────────────────────────────────────
# General-purpose model for query_data.py and agents
OLLAMA_MODEL=llama3.2:1b

# Gemini model (used when --llm gemini or EMBEDDING_PROVIDER=gemini)
GEMINI_MODEL=gemini-1.5-flash

# Groq model
GROQ_MODEL=mixtral-8x7b-32768

# Deepseek model
DEEPSEEK_MODEL=deepseek-chat

# Kimi / Moonshot model
KIMI_MODEL=moonshot-v1-8k

# Unified chat defaults
CHAT_PROVIDER=ollama
CHAT_MODE=auto

# ── API keys ─────────────────────────────────────────────────
# Required when EMBEDDING_PROVIDER=gemini or --llm gemini
GOOGLE_API_KEY=

# Required when EMBEDDING_PROVIDER=bedrock
# AWS credentials are read from ~/.aws/credentials by default.
# Override the profile or region here if needed:
# AWS_PROFILE=default
# AWS_DEFAULT_REGION=us-east-1

# ── Ollama server ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Vector database paths ─────────────────────────────────────
CHROMA_PATH=chroma
DATA_PATH=data

# Qdrant: leave blank for in-memory, or set a remote URL
# QDRANT_URL=http://localhost:6333

# ── Chat history database ────────────────────────────────────
# sqlite (default) or postgres
CHAT_DB_BACKEND=sqlite

# Used when CHAT_DB_BACKEND=sqlite
CHAT_DB_PATH=llm_toolbox/chat_history.db

# Used when CHAT_DB_BACKEND=postgres
# CHAT_DB_DSN=postgresql://user:password@localhost:5432/llm_toolbox
